DB_PATH=./data/bridge.db
COOKIES_PATH=./data/patreon-cookies.txt
DOWNLOAD_DIR=./data/downloads
DOWNLOAD_TEMPLATE=%(uploader)s/%(upload_date)s %(title)s [%(id)s].%(ext)s
# false = queue only (start in the bridge UI); true = download queued videos after each poll
DOWNLOAD_AUTOSTART=false
TA_HOST=http://tubearchivist:8000
TA_API_TOKEN=
# false = queue only (manual download in TA UI); true = start downloading immediately
TA_AUTOSTART=false
PORT=8080
POLL_INTERVAL_MIN=30
